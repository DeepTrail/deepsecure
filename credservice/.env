# This file provides environment variables specifically for the credservice BACKEND
# container when run via `docker compose up`. It is read by Docker Compose, not the shell.

# BACKEND_API_TOKEN: A high-privilege administrative token for the credservice
# itself. The service uses this token to protect its own internal and administrative
# endpoints. It is the service's "master key" and is distinct from client-facing tokens.
BACKEND_API_TOKEN=supersecrettoken123

# ------------------------------------------------------------------------------------
# DATABASE_URL: The connection string for the PostgreSQL database.
#
# IMPORTANT: You will likely need to edit this line to match your local
# PostgreSQL setup.
#
# The format is: postgresql://<user>:<password>@<host>:<port>/<database_name>
#
# - <user>: Replace 'imaxxs' with your local PostgreSQL username.
# - <password>: The example has no password. This assumes your local Postgres is
#   configured for password-less `trust` authentication. If you need a password,
#   add it after the username (e.g., `user:your_password@...`).
# - <host>: `localhost` is standard for local development.
# - <database_name>: Make sure the database `deepsecure-db` exists in your
#   PostgreSQL instance before starting the service.
# ------------------------------------------------------------------------------------
DATABASE_URL=postgresql://imaxxs@localhost:5432/deepsecure-db