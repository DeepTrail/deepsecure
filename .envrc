# This file configures the environment for the DeepSecure CLIENT (the CLI and SDK).
# It is intended to be used with a tool like `direnv` to automatically set
# environment variables when you enter this directory.

# The URL of the backend credential service.
export DEEPSECURE_DEEPTRAIL_CONTROL_URL="http://127.0.0.1:8000"

# A low-privilege token used by the CLIENT to authenticate to the deeptrail-control.
# This represents a "user" or "agent" role, NOT an administrator.
export DEEPSECURE_DEEPTRAIL_CONTROL_API_TOKEN="DEFAULT_QUICKSTART_TOKEN"
